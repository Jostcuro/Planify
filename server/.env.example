# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planify"

# Autenticación Clerk — https://dashboard.clerk.com
# Secret key (sk_test_..., privada) + publishable key (pk_test_..., pública):
# ambas las usa @clerk/express en el backend para verificar sesiones.
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Frontend (client/.env): VITE_CLERK_PUBLISHABLE_KEY con la misma publishable key.

# Servidor
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
